# Copy to `.env` (which is gitignored) and adjust for your machine:
#
#     cp .env.sample .env
#
# Read automatically by the VS Code Python extension via `python.envFile`, and by
# `uv run --env-file .env ...`. A plain shell does NOT read it -- export UV_ENV_FILE=.env
# once if you want `uv run` to pick it up without the flag. See README.md,
# "Local development on this machine".


# --- Databricks Connect ------------------------------------------------------------------
# Which compute runs your Spark code when you execute Python locally. `auto` selects
# serverless. tests/conftest.py already falls back to this on its own; setting it here means
# anything that does NOT go through conftest -- src/smart_claims_dev/main.py, notebooks --
# behaves the same way.
#
# To use a specific cluster instead, drop this line and set DATABRICKS_CLUSTER_ID.
DATABRICKS_SERVERLESS_COMPUTE_ID=auto

# The CLI profile from ~/.databrickscfg to authenticate with. Leave commented to use whatever
# your .databrickscfg marks as default.
#DATABRICKS_CONFIG_PROFILE=DEFAULT


# --- Local toolchain workarounds ---------------------------------------------------------
# Only needed on machines that put unrelated packages on PYTHONPATH -- a sourced ROS 2 setup
# script is the usual culprit. pytest scans PYTHONPATH for plugin entry points, imports what
# it finds, and a plugin that cannot import its own dependencies takes the whole test run
# down with it (e.g. ROS's launch_testing failing on `No module named 'yaml'`).
#
# Note that blanking PYTHONPATH here does NOT work under `uv run`: --env-file follows dotenv
# semantics, so a variable your shell already exports wins over the file. It does apply inside
# VS Code. Disabling plugin autoload is what actually fixes the terminal, and it is the more
# precise fix anyway -- this project uses no pytest plugins.
PYTHONPATH=
PYTEST_DISABLE_PLUGIN_AUTOLOAD=1
